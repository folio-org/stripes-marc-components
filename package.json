{
  "name": "@folio/stripes-marc-components",
  "version": "2.1.0",
  "description": "Component library for Stripes Marc modules",
  "repository": "https://github.com/folio-org/stripes-marc-components",
  "main": "index.js",
  "license": "Apache-2.0",
  "stripes": {
    "actsAs": [
      ""
    ],
    "optionalOkapiInterfaces": {
      "instance-authority-linking-rules": "1.1",
      "audit-marc": "1.0"
    }
  },
  "scripts": {
    "start": "stripes serve",
    "build": "stripes build --output ./output",
    "test": "jest --coverage --verbose",
    "test:color": "jest --coverage --verbose --color",
    "lint": "eslint .",
    "lint:report": "eslint --output-file ./artifacts/eslint_report.json --format json .",
    "formatjs-compile": "stripes translate compile",
    "build-mod-descriptor": "stripes mod descriptor --full --strict | jq '.[]' > module-descriptor.json"
  },
  "devDependencies": {
    "@folio/eslint-config-stripes": "^8.0.0",
    "@folio/jest-config-stripes": "^3.0.0",
    "@folio/stripes": "^10.0.0",
    "@folio/stripes-cli": "^4.0.0",
    "@folio/stripes-components": "^13.0.0",
    "@folio/stripes-testing": "^5.0.0",
    "core-js": "^3.6.1",
    "eslint-plugin-jest": "^29.16.0",
    "history": "^5.0.0",
    "identity-obj-proxy": "^3.0.0",
    "inflected": "^2.0.4",
    "lodash": "^4.17.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-intl": "^10.1.20",
    "react-router": "^8.3.0",
    "react-router-dom": "^7.18.2",
    "react-query": "^3.39.3",
    "regenerator-runtime": "^0.14.1"
  },
  "dependencies": {
    "@folio/stripes-acq-components": "^7.0.0",
    "classnames": "^2.3.2",
    "prop-types": "^15.6.0",
    "query-string": "^9.5.0",
    "react-query": "^3.39.3",
    "react-to-print": "^3.3.0"
  },
  "peerDependencies": {
    "@folio/stripes": "^10.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-intl": "^10.1.20",
    "react-router": "^8.3.0",
    "react-router-dom": "^7.18.2"
  },
  "resolutions": {
    "@rehooks/local-storage": "2.4.4"
  }
}
